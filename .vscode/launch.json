    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: EmoGen",
            // python.exe 的绝对路径
            "python": "/opt/minconda/miniconda3/envs/py39/bin/python",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            // 内部的 cmd
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "9000"
            ],
            // 将工作目录定位到本级文件夹
            "cwd": "${fileDirname}",
        },
    ]
}